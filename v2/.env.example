# 프로젝트 루트 .env 또는 서버 환경변수로 설정합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_VECTOR_STORE_ID=
# 외부 접속은 모든 /api 경로에서 접근 코드가 필요합니다.
COCKPIT_ACCESS_TOKEN=
# 비우면 기존 SQLite 검증용 DB를 사용합니다.
DATABASE_URL=
# 선택: 별도 SQLite 파일
# KGT_SQLITE_PATH=/absolute/path/to/kyungdong_demo.db
